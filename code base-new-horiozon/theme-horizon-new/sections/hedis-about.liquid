{%- comment -%}
  Hedi's — About.
  Simple editorial About page in Hedi's own styling: intro, wide image,
  two body columns, three value pillars and a closing call to action.
  Every word, the image and the three pillars are section settings, so the
  merchant edits all of it in the theme editor without touching code.
  Uses a CSS background image (not an <img> tag) so no fixed dimensions
  are needed and the crop stays clean at every width.
{%- endcomment -%}
{% render 'hedis-home-base' %}
{%- liquid
  assign img = section.settings.image
  assign img_src = section.settings.image_url
  if img != blank
    assign img_src = img | image_url: width: 2400
  endif
-%}
<div class="hh-home hab" id="hab-{{ section.id }}">
  <section class="hab__sec">

    <div class="hh-wrap hab__intro hh-rv">
      {%- if section.settings.kicker != blank -%}
        <p class="hh-kick">{{ section.settings.kicker }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h1 class="hab__h">{{ section.settings.heading }}</h1>
      {%- endif -%}
      {%- if section.settings.lead != blank -%}
        <p class="hab__lead">{{ section.settings.lead }}</p>
      {%- endif -%}
    </div>

    {%- if img_src != blank -%}
      <div class="hab__media hh-rv" style="background-image: url('{{ img_src }}');" role="img"
        aria-label="{{ section.settings.image_alt | default: section.settings.heading | escape }}"></div>
    {%- endif -%}

    {%- if section.settings.body_left != blank or section.settings.body_right != blank -%}
      <div class="hh-wrap hab__body hh-rv">
        {%- if section.settings.body_left != blank -%}
          <div class="hab__col">{{ section.settings.body_left }}</div>
        {%- endif -%}
        {%- if section.settings.body_right != blank -%}
          <div class="hab__col">{{ section.settings.body_right }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="hh-wrap hab__pillars hh-rv">
      {%- for i in (1..3) -%}
        {%- assign t_key = 'pillar' | append: i | append: '_title' -%}
        {%- assign x_key = 'pillar' | append: i | append: '_text' -%}
        {%- assign p_title = section.settings[t_key] -%}
        {%- assign p_text = section.settings[x_key] -%}
        {%- if p_title != blank or p_text != blank -%}
          <div class="hab__pillar">
            {%- if p_title != blank -%}<h3 class="hab__pillar-h">{{ p_title }}</h3>{%- endif -%}
            {%- if p_text != blank -%}<p class="hab__pillar-t">{{ p_text }}</p>{%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- if section.settings.cta_heading != blank or section.settings.cta_label != blank -%}
      <div class="hh-wrap hab__cta hh-rv">
        {%- if section.settings.cta_heading != blank -%}
          <h2 class="hab__cta-h">{{ section.settings.cta_heading }}</h2>
        {%- endif -%}
        {%- if section.settings.cta_text != blank -%}
          <p class="hab__cta-t">{{ section.settings.cta_text }}</p>
        {%- endif -%}
        {%- if section.settings.cta_label != blank -%}
          <a class="hh-btn" href="{{ section.settings.cta_link | default: '/pages/contact' }}">
            {{ section.settings.cta_label }}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}

  </section>
</div>

{% stylesheet %}
  .hab {
    background: var(--bg);
  }

  .hab__sec {
    padding: 80px 0 100px;
  }

  .hab__intro {
    max-width: 780px;
    text-align: center;
  }

  .hab__h {
    font-size: clamp(40px, 5.4vw, 72px);
    margin: 0 0 22px;
  }

  .hab__lead {
    margin: 0;
    font-size: 17px;
    line-height: 1.8;
    color: var(--muted);
  }

  .hab__media {
    margin: 62px 0;
    height: clamp(280px, 46vw, 560px);
    background-size: cover;
    background-position: 50% 50%;
    background-repeat: no-repeat;
  }

  .hab__body {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 52px;
    max-width: 1100px;
  }

  .hab__col {
    font-size: 15px;
    line-height: 1.85;
    color: var(--muted);
  }

  .hab__col p {
    margin: 0 0 18px;
  }

  .hab__col p:last-child {
    margin-bottom: 0;
  }

  .hab__pillars {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 44px;
    max-width: 1100px;
    margin-top: 82px;
    padding-top: 62px;
    border-top: 1px solid #e2ddd5;
  }

  .hab__pillar-h {
    font-size: 26px;
    margin: 0 0 12px;
  }

  .hab__pillar-t {
    margin: 0;
    font-size: 14px;
    line-height: 1.8;
    color: var(--muted);
  }

  .hab__cta {
    margin-top: 86px;
    text-align: center;
    max-width: 660px;
  }

  .hab__cta-h {
    font-size: clamp(30px, 3.6vw, 44px);
    margin: 0 0 16px;
  }

  .hab__cta-t {
    margin: 0 0 6px;
    font-size: 15px;
    line-height: 1.8;
    color: var(--muted);
  }

  @media (max-width: 989px) {
    .hab__body {
      grid-template-columns: 1fr;
      gap: 22px;
    }

    .hab__pillars {
      grid-template-columns: 1fr;
      gap: 36px;
      margin-top: 60px;
      padding-top: 46px;
    }
  }

  @media (max-width: 749px) {
    .hab__sec {
      padding: 56px 0 72px;
    }

    .hab__media {
      margin: 44px 0;
    }

    .hab__cta {
      margin-top: 60px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Hedi's — About",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Intro" },
    { "type": "text", "id": "kicker", "label": "Kicker (small text above heading)", "default": "Our Story" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Timeless pieces for a life well lived" },
    { "type": "textarea", "id": "lead", "label": "Lead paragraph", "default": "Hedi's Furniture is a family showroom in Chestnut Hill, Massachusetts, built on a simple idea: that the pieces you live with every day should be beautiful, honest and made to last." },

    { "type": "header", "content": "Image" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "image_url", "label": "Or image URL (fallback)", "default": "https://cdn.shopify.com/s/files/1/0560/2600/5592/files/full-body-view-of-huxley-sofa-in-contemporary-open-plan-living-space-fulfily-2.jpg?v=1780164479" },
    { "type": "text", "id": "image_alt", "label": "Image description (for accessibility)", "default": "A Hedi's sofa in a light, open living room" },

    { "type": "header", "content": "Body" },
    { "type": "richtext", "id": "body_left", "label": "Left column", "default": "<p>Our designs are inspired by the beauty of natural materials. Solid woods, natural fibres and full-grain leathers, chosen because they age well rather than simply looking new.</p><p>We work with artisans and makers around the world, many of them family workshops like ours, who still use time-honoured techniques and refuse to cut corners.</p>" },
    { "type": "richtext", "id": "body_right", "label": "Right column", "default": "<p>The result is a signature style that marries tradition with distinctly modern finishes. Pieces that feel considered rather than trend-driven, and that settle into a home instead of shouting at it.</p><p>Everything we sell, we would happily live with ourselves. That is the only test a piece has to pass to earn a place in our showroom.</p>" },

    { "type": "header", "content": "What we stand for" },
    { "type": "text", "id": "pillar1_title", "label": "Pillar 1 title", "default": "Artisan made" },
    { "type": "textarea", "id": "pillar1_text", "label": "Pillar 1 text", "default": "Skilled makers, time-honoured techniques and a refusal to cut corners." },
    { "type": "text", "id": "pillar2_title", "label": "Pillar 2 title", "default": "Natural materials" },
    { "type": "textarea", "id": "pillar2_text", "label": "Pillar 2 text", "default": "Solid woods, natural fibres and full-grain leathers chosen to age beautifully." },
    { "type": "text", "id": "pillar3_title", "label": "Pillar 3 title", "default": "Design help" },
    { "type": "textarea", "id": "pillar3_text", "label": "Pillar 3 text", "default": "Complimentary guidance to plan, style and furnish every room with ease." },

    { "type": "header", "content": "Closing call to action" },
    { "type": "text", "id": "cta_heading", "label": "Heading", "default": "Come and see us" },
    { "type": "textarea", "id": "cta_text", "label": "Text", "default": "Our showroom is at 199 Boylston St. in Chestnut Hill. Feel the fabrics, test the seating, and talk your space through with someone who knows the pieces." },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Visit the showroom" },
    { "type": "url", "id": "cta_link", "label": "Button link" }
  ],
  "presets": [
    { "name": "Hedi's — About" }
  ]
}
{% endschema %}
