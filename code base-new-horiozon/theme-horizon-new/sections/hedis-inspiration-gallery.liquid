{%- comment -%}
  Hedi's — Inspirational Gallery (Arhaus "Your Style, Your Story" style)
  Full-bleed masonry of lifestyle/interior images with an editable heading + subtitle.
  Each image is a block: pick a real image (image_picker, recommended) OR paste a URL.
  Per-tile "size" (normal / tall / wide / large) drives the masonry rhythm.
  Optional click-to-zoom lightbox. Shopify-native section — drag onto any page,
  swap images in the theme editor. Scoped styles/JS to #hig-{{ section.id }}.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign heading_text = s.heading
  assign sub_text = s.subheading
-%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Jost:wght@300;400;500&display=swap">

<style>
  #hig-{{ section.id }}{
    --bg: {{ s.bg_color }};
    --ink: {{ s.text_color }};
    --muted: {{ s.muted_color }};
    --gap: {{ s.gap }}px;
    --cols: {{ s.columns }};
    --unit: {{ s.row_unit }}px;
    --maxw: {% if s.full_bleed %}100%{% else %}{{ s.max_width }}px{% endif %};
    --pad: {% if s.full_bleed %}{{ s.gap }}px{% else %}40px{% endif %};
    background: var(--bg);
    color: var(--ink);
    font-family: "Jost","Helvetica Neue",Arial,sans-serif;
    font-weight: 300;
    padding-block: {{ s.padding_top }}px {{ s.padding_bottom }}px;
  }
  #hig-{{ section.id }} *{ box-sizing: border-box; }
  #hig-{{ section.id }} a{ color: inherit; text-decoration: none; }
  #hig-{{ section.id }} img{ display: block; }

  /* Header */
  .hig-crumb-row{ max-width: var(--maxw); margin: 0 auto clamp(30px, 4vw, 54px); padding-inline: clamp(20px, 4vw, 44px); }
  .hig-crumb{ font-size: 12px; letter-spacing: .12em; color: var(--muted); margin: 0; }
  .hig-crumb a:hover{ color: var(--ink); }
  .hig-crumb span{ opacity: .55; margin: 0 8px; }
  .hig-head{ max-width: 820px; margin: 0 auto; padding: 0 24px; text-align: center; }
  #hig-{{ section.id }} .hig-title{
    font-family: "Cormorant Garamond", Georgia, serif;
    font-weight: 500;
    line-height: 1.04;
    letter-spacing: .015em;
    margin: 0;
    color: var(--ink);
    font-size: clamp(34px, 4.6vw, 60px);
  }
  .hig-sub{
    font-family: "Cormorant Garamond", Georgia, serif;
    font-weight: 400;
    margin: 22px auto 0;
    max-width: 48ch;
    font-size: clamp(17px, 1.5vw, 21px);
    line-height: 1.55;
    color: var(--ink);
  }
  .hig-gaptop{ height: clamp(54px, 7vw, 104px); }

  /* Masonry grid */
  .hig-grid{
    max-width: var(--maxw);
    margin: 0 auto;
    padding-inline: var(--pad);
    display: grid;
    grid-template-columns: repeat(var(--cols), 1fr);
    grid-auto-rows: var(--unit);
    grid-auto-flow: row dense;
    gap: var(--gap);
  }
  .hig-item{
    position: relative;
    overflow: hidden;
    grid-row: span 4;            /* normal */
    background: #efeae3;
    cursor: default;
  }
  .hig-item[data-size="tall"]{ grid-row: span 8; }                       /* 1x2 — exactly 2 normals tall, so it tessellates */
  .hig-item[data-size="wide"]{ grid-column: span 2; grid-row: span 4; }  /* 2x1 */
  .hig-item[data-size="large"]{ grid-column: span 2; grid-row: span 8; } /* 2x2 */
  .hig-item.is-clickable{ cursor: pointer; }
  .hig-item .hig-img{
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    transition: transform 1.4s cubic-bezier(.2,.6,.2,1);
    will-change: transform;
  }
  .hig-item.is-clickable:hover .hig-img{ transform: scale(1.045); }
  .hig-item .placeholder-svg{ position: absolute; inset: 0; width: 100%; height: 100%; background: #efeae3; }

  /* Reveal (gated on .hig-js so tiles stay visible if JS is off or fails) */
  #hig-{{ section.id }}.hig-js .hig-item{ opacity: 0; transform: translateY(26px); transition: opacity .9s ease, transform .9s ease; }
  #hig-{{ section.id }}.hig-js .hig-item.in{ opacity: 1; transform: none; }

  /* Lightbox */
  .hig-lb{ position: fixed; inset: 0; z-index: 9999; display: none; align-items: center; justify-content: center;
           background: rgba(18,16,14,.93); padding: 4vmin; }
  .hig-lb.open{ display: flex; }
  .hig-lb__img{ max-width: 92vw; max-height: 92vh; width: auto; height: auto; object-fit: contain;
                box-shadow: 0 10px 60px rgba(0,0,0,.5); }
  .hig-lb__btn{ position: absolute; background: transparent; border: 0; color: #fff; cursor: pointer;
                width: 56px; height: 56px; font-size: 30px; line-height: 1; opacity: .85; transition: opacity .2s; }
  .hig-lb__btn:hover{ opacity: 1; }
  .hig-lb__close{ top: 14px; right: 18px; font-size: 34px; }
  .hig-lb__prev{ left: 8px; top: 50%; transform: translateY(-50%); }
  .hig-lb__next{ right: 8px; top: 50%; transform: translateY(-50%); }

  @media (max-width: 1100px){
    #hig-{{ section.id }}{ --cols: 4; --unit: {{ s.row_unit | times: 0.92 | round }}px; }
  }
  @media (max-width: 749px){
    #hig-{{ section.id }}{ --cols: 2; --unit: {{ s.row_unit_mobile }}px; }
    .hig-crumb-row{ margin-bottom: 26px; }
    .hig-item[data-size="tall"]{ grid-row: span 4; }   /* demote tall to a square on 2-col mobile (stays on-module) */
  }
</style>

<div id="hig-{{ section.id }}">
  <script>(function(){var r=document.getElementById('hig-{{ section.id }}');if(r)r.classList.add('hig-js');})();</script>
  {%- if s.show_breadcrumb -%}
    <div class="hig-crumb-row"><p class="hig-crumb"><a href="{{ routes.root_url }}">Home</a><span>/</span>{{ page.title | default: heading_text }}</p></div>
  {%- endif -%}
  <div class="hig-head">
    {%- if heading_text != blank -%}<h1 class="hig-title">{{ heading_text }}</h1>{%- endif -%}
    {%- if sub_text != blank -%}<p class="hig-sub">{{ sub_text }}</p>{%- endif -%}
  </div>

  <div class="hig-gaptop"></div>

  <div class="hig-grid" data-hig-grid>
    {%- for block in section.blocks -%}
      {%- liquid
        assign pic = block.settings.image
        assign url = block.settings.image_url
        assign link = block.settings.link
        assign full = ''
        assign thumb = ''
        if pic != blank
          assign thumb = pic | image_url: width: 1200
          assign full = pic | image_url: width: 2200
        elsif url != blank
          assign thumb = url
          assign full = url
        endif
      -%}
      {%- if link != blank -%}
        <a class="hig-item is-clickable" data-size="{{ block.settings.size }}" href="{{ link }}" {{ block.shopify_attributes }}>
          {%- if thumb != blank -%}
            <img class="hig-img" src="{{ thumb }}" loading="lazy" alt="{{ pic.alt | default: block.settings.alt | escape }}">
          {%- else -%}
            {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </a>
      {%- else -%}
        <div class="hig-item{% if full != blank and s.enable_lightbox %} is-clickable{% endif %}" data-size="{{ block.settings.size }}"
             {% if full != blank and s.enable_lightbox %}data-full="{{ full }}" role="button" tabindex="0" aria-label="View image"{% endif %} {{ block.shopify_attributes }}>
          {%- if thumb != blank -%}
            <img class="hig-img" src="{{ thumb }}" loading="lazy" alt="{{ pic.alt | default: block.settings.alt | escape }}">
          {%- else -%}
            {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>

  {%- if s.enable_lightbox -%}
  <div class="hig-lb" data-hig-lb aria-hidden="true">
    <button class="hig-lb__btn hig-lb__close" data-lb-close aria-label="Close">&times;</button>
    <button class="hig-lb__btn hig-lb__prev" data-lb-prev aria-label="Previous">&#8249;</button>
    <img class="hig-lb__img" data-lb-img src="" alt="">
    <button class="hig-lb__btn hig-lb__next" data-lb-next aria-label="Next">&#8250;</button>
  </div>
  {%- endif -%}
</div>

<script>
(function(){
  var root = document.getElementById('hig-{{ section.id }}');
  if(!root) return;
  root.classList.add('hig-js');

  /* Reveal on scroll */
  var items = root.querySelectorAll('.hig-item');
  if('IntersectionObserver' in window){
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(e){ if(e.isIntersecting){ e.target.classList.add('in'); io.unobserve(e.target); } });
    }, { rootMargin: '0px 0px -8% 0px' });
    items.forEach(function(el, i){ el.style.transitionDelay = (Math.min(i,8)*40) + 'ms'; io.observe(el); });
  } else {
    items.forEach(function(el){ el.classList.add('in'); });
  }

  /* Lightbox */
  var lb = root.querySelector('[data-hig-lb]');
  if(lb){
    var lbImg = lb.querySelector('[data-lb-img]');
    var triggers = Array.prototype.slice.call(root.querySelectorAll('.hig-item[data-full]'));
    var idx = -1;
    function show(i){
      if(i < 0) i = triggers.length - 1;
      if(i >= triggers.length) i = 0;
      idx = i;
      lbImg.src = triggers[i].getAttribute('data-full');
      lb.classList.add('open'); lb.setAttribute('aria-hidden','false');
      document.documentElement.style.overflow = 'hidden';
    }
    function close(){ lb.classList.remove('open'); lb.setAttribute('aria-hidden','true'); lbImg.src=''; document.documentElement.style.overflow=''; }
    triggers.forEach(function(t, i){
      t.addEventListener('click', function(){ show(i); });
      t.addEventListener('keydown', function(ev){ if(ev.key==='Enter'||ev.key===' '){ ev.preventDefault(); show(i); } });
    });
    lb.querySelector('[data-lb-close]').addEventListener('click', close);
    lb.querySelector('[data-lb-prev]').addEventListener('click', function(){ show(idx-1); });
    lb.querySelector('[data-lb-next]').addEventListener('click', function(){ show(idx+1); });
    lb.addEventListener('click', function(e){ if(e.target === lb) close(); });
    document.addEventListener('keydown', function(e){
      if(!lb.classList.contains('open')) return;
      if(e.key==='Escape') close();
      else if(e.key==='ArrowLeft') show(idx-1);
      else if(e.key==='ArrowRight') show(idx+1);
    });
  }
})();
</script>

{% schema %}
{
  "name": "Inspirational Gallery",
  "tag": "section",
  "class": "hedis-inspiration-gallery",
  "settings": [
    { "type": "header", "content": "Heading" },
    { "type": "checkbox", "id": "show_breadcrumb", "label": "Show breadcrumb (Home / page)", "default": true },
    { "type": "text", "id": "heading", "label": "Heading", "default": "YOUR STYLE, YOUR STORY" },
    { "type": "textarea", "id": "subheading", "label": "Subtitle", "default": "Explore real homes, real moments, and inspired designs shared by Hedi's clients, partners, and designers." },

    { "type": "header", "content": "Gallery layout" },
    { "type": "range", "id": "columns", "min": 3, "max": 6, "step": 1, "label": "Columns (desktop)", "default": 5 },
    { "type": "range", "id": "gap", "min": 0, "max": 24, "step": 1, "unit": "px", "label": "Gap between images", "default": 4 },
    { "type": "checkbox", "id": "full_bleed", "label": "Full-bleed (edge to edge)", "default": true },
    { "type": "range", "id": "max_width", "min": 1000, "max": 2000, "step": 20, "unit": "px", "label": "Max width (when not full-bleed)", "default": 1600 },
    { "type": "range", "id": "row_unit", "min": 50, "max": 160, "step": 2, "unit": "px", "label": "Row height unit (desktop)", "info": "Controls overall tile height/scale. Lower = shorter tiles.", "default": 84 },
    { "type": "range", "id": "row_unit_mobile", "min": 36, "max": 120, "step": 2, "unit": "px", "label": "Row height unit (mobile)", "default": 58 },
    { "type": "checkbox", "id": "enable_lightbox", "label": "Click image to zoom (lightbox)", "default": true },

    { "type": "header", "content": "Colors & spacing" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#1c1a17" },
    { "type": "color", "id": "muted_color", "label": "Muted text / breadcrumb", "default": "#8a847c" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Padding top", "default": 64 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Padding bottom", "default": 64 }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image (recommended)" },
        { "type": "text", "id": "image_url", "label": "…or image URL", "info": "Used only if no image is picked above." },
        { "type": "select", "id": "size", "label": "Tile size", "default": "normal", "options": [
          { "value": "normal", "label": "Normal" },
          { "value": "tall", "label": "Tall" },
          { "value": "wide", "label": "Wide (2 columns)" },
          { "value": "large", "label": "Large feature (2 columns, tall)" }
        ] },
        { "type": "url", "id": "link", "label": "Link (optional)" },
        { "type": "text", "id": "alt", "label": "Alt text (for URL images)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Inspirational Gallery",
      "settings": { "heading": "YOUR STYLE, YOUR STORY", "subheading": "Explore real homes, real moments, and inspired designs shared by Hedi's clients, partners, and designers." },
      "blocks": [
