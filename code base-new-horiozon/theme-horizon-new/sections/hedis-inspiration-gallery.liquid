        { "type": "image", "settings": { "size": "normal", "image_url": "https://cdn.shopify.com/s/files/1/0560/2600/5592/files/full-shot-of-kandor-leather-sofa-in-modern-living-room-fulfily-1.jpg?v=1777176616" } },
