{%- comment -%}
  Hedi's — Contact Us.
  Premium-retailer contact layout (contact methods, showroom card with hours,
  native contact form), rebuilt in Hedi's own styling.
  Uses Shopify's NATIVE contact form so messages email the store contact
  address (Settings > General). No app, no third party.
  Every label, address line and hours line is a section setting, so the
  merchant edits all of it in the theme editor without touching code.
{%- endcomment -%}
{% render 'hedis-home-base' %}
{%- liquid
  assign form_id = 'HedisContact-' | append: section.id
  assign hours_lines = section.settings.hours | newline_to_br | split: '<br />'
  assign address_lines = section.settings.address | newline_to_br | split: '<br />'
  assign tel_href = section.settings.phone | remove: ' ' | remove: '-' | remove: '(' | remove: ')'
-%}
<div class="hh-home hct" id="hct-{{ section.id }}">
  <section class="hct__sec hh-rv">
    <div class="hh-wrap hct__wrap">

      <header class="hct__head">
        {%- if section.settings.kicker != blank -%}
          <p class="hh-kick">{{ section.settings.kicker }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h1 class="hct__h">{{ section.settings.heading }}</h1>
        {%- endif -%}
        {%- if section.settings.intro != blank -%}
          <p class="hct__intro">{{ section.settings.intro }}</p>
        {%- endif -%}
      </header>

      <div class="hct__methods">
        {%- if section.settings.phone != blank -%}
          <div class="hct__card">
            <p class="hct__card-k">{{ section.settings.label_call }}</p>
            <a class="hct__card-v" href="tel:{{ tel_href }}">{{ section.settings.phone }}</a>
            {%- if section.settings.phone_note != blank -%}
              <p class="hct__card-n">{{ section.settings.phone_note }}</p>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if section.settings.email != blank -%}
          <div class="hct__card">
            <p class="hct__card-k">{{ section.settings.label_email }}</p>
            <a class="hct__card-v" href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a>
            {%- if section.settings.email_note != blank -%}
              <p class="hct__card-n">{{ section.settings.email_note }}</p>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if section.settings.appointment_link != blank -%}
          <div class="hct__card">
            <p class="hct__card-k">{{ section.settings.label_appointment }}</p>
            <a class="hct__card-v" href="{{ section.settings.appointment_link }}">{{ section.settings.appointment_cta }}</a>
            {%- if section.settings.appointment_note != blank -%}
              <p class="hct__card-n">{{ section.settings.appointment_note }}</p>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>

      <div class="hct__split">

        <aside class="hct__store">
          <h2 class="hct__h2">{{ section.settings.showroom_heading }}</h2>

          {%- if address_lines.size > 0 -%}
            <address class="hct__addr">
              {%- for line in address_lines -%}
                {%- assign address_line = line | strip_newlines | strip -%}
                {%- if address_line != blank -%}
                  <span class="hct__addr-l">{{ address_line }}</span>
                {%- endif -%}
              {%- endfor -%}
            </address>
          {%- endif -%}

          {%- if section.settings.map_link != blank -%}
            <a class="hct__map" href="{{ section.settings.map_link }}" target="_blank" rel="noopener">
              {{ section.settings.map_label }}
            </a>
          {%- endif -%}

          {%- if hours_lines.size > 0 -%}
            <div class="hct__hours">
              <p class="hct__hours-k">{{ section.settings.hours_heading }}</p>
              {%- for line in hours_lines -%}
                {%- assign hours_line = line | strip_newlines | strip -%}
                {%- if hours_line != blank -%}
                  <p class="hct__hours-l">{{ hours_line }}</p>
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- endif -%}

          {%- if section.settings.hours_note != blank -%}
            <p class="hct__card-n">{{ section.settings.hours_note }}</p>
          {%- endif -%}
        </aside>

        <div class="hct__formwrap">
          <h2 class="hct__h2">{{ section.settings.form_heading }}</h2>
          {%- if section.settings.form_intro != blank -%}
            <p class="hct__formintro">{{ section.settings.form_intro }}</p>
          {%- endif -%}

          {%- form 'contact', id: form_id, class: 'hct__form' -%}
            <input type="hidden" name="contact[id]" value="{{ form_id }}">

            {%- if form.errors and form.id == form_id -%}
              <div class="hct__msg hct__msg--err" tabindex="-1" autofocus>
                {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
              </div>
            {%- endif -%}

            {%- if form.posted_successfully? and form.id == form_id -%}
              <div class="hct__msg hct__msg--ok" tabindex="-1" autofocus>
                <strong class="hct__thanks">{{ section.settings.success_heading }}</strong>
                <span>{{ section.settings.success_text }}</span>
              </div>
            {%- else -%}
              <p class="hct__field">
                <label class="hct__label" for="{{ form_id }}-name">
                  {{ section.settings.label_name }} <span class="hct__req" aria-hidden="true">*</span>
                </label>
                <input
                  class="hct__input"
                  type="text"
                  id="{{ form_id }}-name"
                  name="contact[name]"
                  autocomplete="name"
                  required
                  value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
                >
              </p>

              <p class="hct__field">
                <label class="hct__label" for="{{ form_id }}-email">
                  {{ section.settings.label_email_field }} <span class="hct__req" aria-hidden="true">*</span>
                </label>
                <input
                  class="hct__input"
                  type="email"
                  id="{{ form_id }}-email"
                  name="contact[email]"
                  autocomplete="email"
                  spellcheck="false"
                  autocapitalize="off"
                  required
                  value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                >
              </p>

              <p class="hct__field">
                <label class="hct__label" for="{{ form_id }}-phone">{{ section.settings.label_phone_field }}</label>
                <input
                  class="hct__input"
                  type="tel"
                  id="{{ form_id }}-phone"
                  name="contact[phone]"
                  autocomplete="tel"
                  value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
                >
              </p>

              <p class="hct__field">
                <label class="hct__label" for="{{ form_id }}-body">
                  {{ section.settings.label_message }} <span class="hct__req" aria-hidden="true">*</span>
                </label>
                <textarea
                  class="hct__input hct__area"
                  id="{{ form_id }}-body"
                  rows="6"
                  name="contact[body]"
                  required
                >{{ form.body }}</textarea>
              </p>

              <div class="hct__foot">
                <button type="submit" class="hh-btn hct__submit">{{ section.settings.submit_label }}</button>
                {%- if section.settings.footnote != blank -%}
                  <p class="hct__card-n">{{ section.settings.footnote }}</p>
                {%- endif -%}
              </div>
            {%- endif -%}
          {%- endform -%}
        </div>

      </div>
    </div>
  </section>
</div>

{% stylesheet %}
  .hct {
    background: var(--bg);
  }

  .hct__sec {
    padding: 80px 0 100px;
  }

  .hct__wrap {
    max-width: 1140px;
  }

  .hct__head {
    text-align: center;
    margin-bottom: 56px;
  }

  .hct__h {
    font-size: clamp(38px, 5vw, 64px);
    margin: 0 0 18px;
  }

  .hct__intro {
    margin: 0 auto;
    max-width: 640px;
    font-size: 15px;
    line-height: 1.75;
    color: var(--muted);
  }

  .hct__methods {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-bottom: 64px;
  }

  .hct__card {
    border: 1px solid #e2ddd5;
    padding: 30px 26px;
    text-align: center;
  }

  .hct__card-k {
    margin: 0 0 12px;
    font-size: 10px;
    letter-spacing: .24em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .hct__card-v {
    display: inline-block;
    font-family: "Cormorant Garamond", Georgia, serif;
    font-size: 24px;
    color: var(--ink);
    border-bottom: 1px solid transparent;
    transition: border-color .3s ease;
  }

  .hct__card-v:hover {
    border-bottom-color: var(--accent);
  }

  .hct__card-n {
    margin: 12px 0 0;
    font-size: 12px;
    line-height: 1.7;
    color: var(--muted);
  }

  .hct__split {
    display: grid;
    grid-template-columns: 1fr 1.25fr;
    gap: 56px;
    align-items: start;
  }

  .hct__h2 {
    font-size: 30px;
    margin: 0 0 22px;
  }

  .hct__store {
    border: 1px solid #e2ddd5;
    padding: 34px 30px;
  }

  .hct__addr {
    font-style: normal;
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: 15px;
    line-height: 1.7;
    color: var(--ink);
  }

  .hct__map {
    display: inline-block;
    margin-top: 18px;
    font-size: 11px;
    letter-spacing: .2em;
    text-transform: uppercase;
    color: var(--accent);
    border-bottom: 1px solid currentColor;
    padding-bottom: 3px;
  }

  .hct__hours {
    margin-top: 30px;
    padding-top: 24px;
    border-top: 1px solid #e2ddd5;
  }

  .hct__hours-k {
    margin: 0 0 12px;
    font-size: 10px;
    letter-spacing: .24em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .hct__hours-l {
    margin: 0 0 6px;
    font-size: 15px;
    color: var(--ink);
  }

  .hct__formintro {
    margin: -8px 0 26px;
    font-size: 14px;
    line-height: 1.7;
    color: var(--muted);
  }

  .hct__form {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .hct__field {
    display: flex;
    flex-direction: column;
    gap: 9px;
    margin: 0;
  }

  .hct__label {
    font-size: 10px;
    letter-spacing: .22em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .hct__req {
    color: var(--accent);
  }

  .hct__input {
    width: 100%;
    padding: 14px 16px;
    border: 1px solid #d8d3cb;
    background: #fff;
    color: var(--ink);
    font-family: inherit;
    font-size: 15px;
    font-weight: 300;
    border-radius: 0;
    transition: border-color .3s ease;
  }

  .hct__input:focus {
    outline: none;
    border-color: var(--accent);
  }

  .hct__area {
    resize: vertical;
    font-family: inherit;
  }

  .hct__foot {
    margin-top: 6px;
  }

  .hct__submit {
    margin-top: 0;
  }

  .hct__msg {
    padding: 22px 26px;
    border: 1px solid #d8d3cb;
    font-size: 15px;
    line-height: 1.7;
  }

  .hct__msg--ok {
    display: flex;
    flex-direction: column;
    gap: 10px;
    border-color: var(--accent);
  }

  .hct__msg--err {
    border-color: #b3453b;
    color: #b3453b;
  }

  .hct__thanks {
    font-family: "Cormorant Garamond", Georgia, serif;
    font-size: 28px;
    font-weight: 500;
    letter-spacing: .04em;
    text-transform: uppercase;
    color: var(--ink);
  }

  @media (max-width: 989px) {
    .hct__methods {
      grid-template-columns: 1fr;
    }

    .hct__split {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }

  @media (max-width: 749px) {
    .hct__sec {
      padding: 56px 0 72px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Hedi's — Contact",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "kicker", "label": "Kicker (small text above heading)", "default": "We Are Here To Help" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Contact Us" },
    { "type": "textarea", "id": "intro", "label": "Intro text", "default": "Questions about a piece, an order or a room you are planning? Our team is happy to help, by phone, by email or in the showroom." },

    { "type": "header", "content": "Contact methods" },
    { "type": "text", "id": "label_call", "label": "Call heading", "default": "Call Us" },
    { "type": "text", "id": "phone", "label": "Phone number", "default": "+1 857-317-0775" },
    { "type": "text", "id": "phone_note", "label": "Call note", "default": "Monday to Saturday, 11am to 6pm" },
    { "type": "text", "id": "label_email", "label": "Email heading", "default": "Email Us" },
    { "type": "text", "id": "email", "label": "Email address", "default": "info@hedisfurniture.com" },
    { "type": "text", "id": "email_note", "label": "Email note", "default": "We reply within one business day" },
    { "type": "text", "id": "label_appointment", "label": "Appointment heading", "default": "Book A Visit" },
    { "type": "text", "id": "appointment_cta", "label": "Appointment link text", "default": "Make an appointment" },
    { "type": "url", "id": "appointment_link", "label": "Appointment link" },
    { "type": "text", "id": "appointment_note", "label": "Appointment note", "default": "Complimentary design guidance" },

    { "type": "header", "content": "Showroom" },
    { "type": "text", "id": "showroom_heading", "label": "Showroom heading", "default": "Visit Our Showroom" },
    { "type": "textarea", "id": "address", "label": "Address (one line per row)", "default": "Hedi's Furniture\n199 Boylston St., N 231\nChestnut Hill, MA 02467" },
    { "type": "text", "id": "map_label", "label": "Map link text", "default": "Get directions" },
    { "type": "url", "id": "map_link", "label": "Map link" },
    { "type": "text", "id": "hours_heading", "label": "Hours heading", "default": "Store Hours" },
    { "type": "textarea", "id": "hours", "label": "Hours (one line per row)", "default": "Monday to Saturday: 11:00am to 6:00pm\nSunday: 12:00pm to 6:00pm" },
    { "type": "textarea", "id": "hours_note", "label": "Hours note", "default": "Holiday hours may vary. Please call ahead if you are travelling to see us." },

    { "type": "header", "content": "Form" },
    { "type": "text", "id": "form_heading", "label": "Form heading", "default": "Send Us A Message" },
    { "type": "textarea", "id": "form_intro", "label": "Form intro", "default": "Tell us what you are looking for and we will get back to you." },
    { "type": "text", "id": "label_name", "label": "Name label", "default": "Name" },
    { "type": "text", "id": "label_email_field", "label": "Email label", "default": "Email" },
    { "type": "text", "id": "label_phone_field", "label": "Phone label", "default": "Phone Number" },
    { "type": "text", "id": "label_message", "label": "Message label", "default": "How can we help?" },
    { "type": "text", "id": "submit_label", "label": "Button label", "default": "Send Message" },
    { "type": "textarea", "id": "footnote", "label": "Small print under button", "default": "We will never share your details." },
    { "type": "text", "id": "success_heading", "label": "Thank-you heading", "default": "Thank You" },
    { "type": "textarea", "id": "success_text", "label": "Thank-you text", "default": "Your message has been received. A member of our team will be in touch shortly." }
  ],
  "presets": [
    { "name": "Hedi's — Contact" }
  ]
}
{% endschema %}
