{%- comment -%}
  Hedi's — Make an Appointment.
  Modeled on the Arhaus appointment page layout, rebuilt in Hedi's own styling.
  Uses Shopify's NATIVE contact form so submissions email the store contact
  address (Settings > General) — no app, no third party.
  Every label, option list and button word is a section setting, so the
  merchant edits all of it in the theme editor without touching code.
{%- endcomment -%}
{% render 'hedis-home-base' %}
{%- liquid
  assign form_id = 'HedisAppointment-' | append: section.id
  assign showrooms = section.settings.showroom_options | newline_to_br | split: '<br />'
  assign rooms = section.settings.room_options | newline_to_br | split: '<br />'
  assign stages = section.settings.stage_options | newline_to_br | split: '<br />'
-%}
<div class="hh-home hap" id="hap-{{ section.id }}">
  <section class="hap__sec hh-rv">
    <div class="hh-wrap hap__wrap">

      <header class="hap__head">
        {%- if section.settings.kicker != blank -%}
          <p class="hh-kick">{{ section.settings.kicker }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h1 class="hap__h">{{ section.settings.heading }}</h1>
        {%- endif -%}
        {%- if section.settings.intro != blank -%}
          <p class="hap__intro">{{ section.settings.intro }}</p>
        {%- endif -%}
      </header>

      {%- form 'contact', id: form_id, class: 'hap__form' -%}
        <input type="hidden" name="contact[id]" value="{{ form_id }}">

        {%- if form.errors and form.id == form_id -%}
          <div class="hap__msg hap__msg--err" tabindex="-1" autofocus>
            {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
          </div>
        {%- endif -%}

        {%- if form.posted_successfully? and form.id == form_id -%}
          <div class="hap__msg hap__msg--ok" tabindex="-1" autofocus>
            <strong class="hap__thanks">{{ section.settings.success_heading }}</strong>
            <span>{{ section.settings.success_text }}</span>
          </div>
        {%- else -%}

          <div class="hap__row">
            <p class="hap__field">
              <label class="hap__label" for="{{ form_id }}-first">
                {{ section.settings.label_first }} <span class="hap__req" aria-hidden="true">*</span>
              </label>
              <input
                class="hap__input"
                type="text"
                id="{{ form_id }}-first"
                name="contact[First name]"
                autocomplete="given-name"
                required
              >
            </p>
            <p class="hap__field">
              <label class="hap__label" for="{{ form_id }}-last">
                {{ section.settings.label_last }} <span class="hap__req" aria-hidden="true">*</span>
              </label>
              <input
                class="hap__input"
                type="text"
                id="{{ form_id }}-last"
                name="contact[Last name]"
                autocomplete="family-name"
                required
              >
            </p>
          </div>

          <div class="hap__row">
            <p class="hap__field">
              <label class="hap__label" for="{{ form_id }}-email">
                {{ section.settings.label_email }} <span class="hap__req" aria-hidden="true">*</span>
              </label>
              <input
                class="hap__input"
                type="email"
                id="{{ form_id }}-email"
                name="contact[email]"
                autocomplete="email"
                spellcheck="false"
                autocapitalize="off"
                required
                value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
              >
            </p>
            <p class="hap__field">
              <label class="hap__label" for="{{ form_id }}-phone">{{ section.settings.label_phone }}</label>
              <input
                class="hap__input"
                type="tel"
                id="{{ form_id }}-phone"
                name="contact[phone]"
                autocomplete="tel"
                value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
              >
            </p>
          </div>

          {%- if showrooms.size > 0 -%}
            <p class="hap__field">
              <label class="hap__label" for="{{ form_id }}-showroom">
                {{ section.settings.label_showroom }} <span class="hap__req" aria-hidden="true">*</span>
              </label>
              <select
                class="hap__input hap__select"
                id="{{ form_id }}-showroom"
                name="contact[Preferred showroom]"
                required
              >
                <option value="">{{ section.settings.select_placeholder }}</option>
                {%- for showroom in showrooms -%}
                  {%- assign showroom_name = showroom | strip_newlines | strip -%}
                  {%- if showroom_name != blank -%}
                    <option value="{{ showroom_name | escape }}">{{ showroom_name }}</option>
                  {%- endif -%}
                {%- endfor -%}
              </select>
            </p>
          {%- endif -%}

          {%- if section.settings.show_designer -%}
            <p class="hap__field">
              <label class="hap__label" for="{{ form_id }}-designer">{{ section.settings.label_designer }}</label>
              <input
                class="hap__input"
                type="text"
                id="{{ form_id }}-designer"
                name="contact[Preferred designer]"
              >
            </p>
          {%- endif -%}

          {%- if rooms.size > 0 -%}
            <fieldset class="hap__group">
              <legend class="hap__legend">{{ section.settings.label_rooms }}</legend>
              <div class="hap__opts">
                {%- for room in rooms -%}
                  {%- assign room_name = room | strip_newlines | strip -%}
                  {%- if room_name != blank -%}
                    <label class="hap__opt">
                      <input type="radio" name="contact[Space]" value="{{ room_name | escape }}">
                      <span class="hap__opt-t">{{ room_name }}</span>
                    </label>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            </fieldset>
          {%- endif -%}

          {%- if stages.size > 0 -%}
            <fieldset class="hap__group">
              <legend class="hap__legend">{{ section.settings.label_stages }}</legend>
              <div class="hap__opts">
                {%- for stage in stages -%}
                  {%- assign stage_name = stage | strip_newlines | strip -%}
                  {%- if stage_name != blank -%}
                    <label class="hap__opt">
                      <input type="radio" name="contact[Project stage]" value="{{ stage_name | escape }}">
                      <span class="hap__opt-t">{{ stage_name }}</span>
                    </label>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            </fieldset>
          {%- endif -%}

          {%- if section.settings.show_date -%}
            <p class="hap__field hap__field--half">
              <label class="hap__label" for="{{ form_id }}-date">{{ section.settings.label_date }}</label>
              <input
                class="hap__input"
                type="date"
                id="{{ form_id }}-date"
                name="contact[Target completion date]"
              >
            </p>
          {%- endif -%}

          {%- if section.settings.show_message -%}
            <p class="hap__field">
              <label class="hap__label" for="{{ form_id }}-body">{{ section.settings.label_message }}</label>
              <textarea
                class="hap__input hap__area"
                id="{{ form_id }}-body"
                rows="5"
                name="contact[body]"
              >{{ form.body }}</textarea>
            </p>
          {%- endif -%}

          <div class="hap__foot">
            <button type="submit" class="hh-btn hap__submit">{{ section.settings.submit_label }}</button>
            {%- if section.settings.footnote != blank -%}
              <p class="hap__note">{{ section.settings.footnote }}</p>
            {%- endif -%}
          </div>

        {%- endif -%}
      {%- endform -%}

    </div>
  </section>
</div>

{% stylesheet %}
  .hap {
    background: var(--bg);
  }

  .hap__sec {
    padding: 88px 0 104px;
  }

  .hap__wrap {
    max-width: 860px;
  }

  .hap__head {
    text-align: center;
    margin-bottom: 52px;
  }

  .hap__h {
    font-size: clamp(38px, 5vw, 66px);
    margin: 0 0 18px;
  }

  .hap__intro {
    margin: 0 auto;
    max-width: 620px;
    font-size: 15px;
    line-height: 1.75;
    color: var(--muted);
  }

  .hap__form {
    display: flex;
    flex-direction: column;
    gap: 26px;
  }

  .hap__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 26px;
  }

  .hap__field {
    display: flex;
    flex-direction: column;
    gap: 9px;
    margin: 0;
  }

  .hap__field--half {
    max-width: 300px;
  }

  .hap__label {
    font-size: 10px;
    letter-spacing: .22em;
    text-transform: uppercase;
    color: var(--muted);
    font-weight: 400;
  }

  .hap__req {
    color: var(--accent);
  }

  .hap__input {
    width: 100%;
    padding: 14px 16px;
    border: 1px solid #d8d3cb;
    background: #fff;
    color: var(--ink);
    font-family: inherit;
    font-size: 15px;
    font-weight: 300;
    border-radius: 0;
    transition: border-color .3s ease;
  }

  .hap__input:focus {
    outline: none;
    border-color: var(--accent);
  }

  .hap__select {
    appearance: none;
    background-image: linear-gradient(45deg, transparent 50%, var(--muted) 50%), linear-gradient(135deg, var(--muted) 50%, transparent 50%);
    background-position: calc(100% - 20px) 50%, calc(100% - 14px) 50%;
    background-size: 6px 6px, 6px 6px;
    background-repeat: no-repeat;
    padding-right: 42px;
  }

  .hap__area {
    resize: vertical;
    font-family: inherit;
  }

  .hap__group {
    border: 0;
    padding: 0;
    margin: 6px 0 0;
  }

  .hap__legend {
    font-size: 10px;
    letter-spacing: .22em;
    text-transform: uppercase;
    color: var(--muted);
    padding: 0;
    margin-bottom: 16px;
  }

  .hap__opts {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .hap__opt {
    position: relative;
    cursor: pointer;
  }

  .hap__opt input {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
  }

  .hap__opt-t {
    display: inline-block;
    padding: 12px 22px;
    border: 1px solid #d8d3cb;
    font-size: 12px;
    letter-spacing: .08em;
    color: var(--ink);
    transition: all .3s ease;
  }

  .hap__opt:hover .hap__opt-t {
    border-color: var(--accent);
  }

  .hap__opt input:checked + .hap__opt-t {
    background: var(--ink);
    border-color: var(--ink);
    color: #fff;
  }

  .hap__opt input:focus-visible + .hap__opt-t {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .hap__foot {
    margin-top: 14px;
    text-align: center;
  }

  .hap__submit {
    margin-top: 0;
  }

  .hap__note {
    margin: 18px 0 0;
    font-size: 12px;
    line-height: 1.7;
    color: var(--muted);
  }

  .hap__msg {
    padding: 22px 26px;
    border: 1px solid #d8d3cb;
    font-size: 15px;
    line-height: 1.7;
  }

  .hap__msg--ok {
    display: flex;
    flex-direction: column;
    gap: 10px;
    text-align: center;
    border-color: var(--accent);
  }

  .hap__msg--err {
    border-color: #b3453b;
    color: #b3453b;
  }

  .hap__thanks {
    font-family: "Cormorant Garamond", Georgia, serif;
    font-size: 30px;
    font-weight: 500;
    letter-spacing: .04em;
    text-transform: uppercase;
    color: var(--ink);
  }

  @media (max-width: 749px) {
    .hap__sec {
      padding: 60px 0 72px;
    }

    .hap__row {
      grid-template-columns: 1fr;
    }

    .hap__field--half {
      max-width: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Hedi's — Appointment",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "kicker", "label": "Kicker (small text above heading)", "default": "Design Services" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Make an Appointment" },
    { "type": "textarea", "id": "intro", "label": "Intro text", "default": "Enter your information and a Hedi's design consultant will reach out as you begin your project." },

    { "type": "header", "content": "Field labels" },
    { "type": "text", "id": "label_first", "label": "First name", "default": "First Name" },
    { "type": "text", "id": "label_last", "label": "Last name", "default": "Last Name" },
    { "type": "text", "id": "label_email", "label": "Email", "default": "Email" },
    { "type": "text", "id": "label_phone", "label": "Phone", "default": "Phone Number" },
    { "type": "text", "id": "label_showroom", "label": "Showroom", "default": "Preferred Showroom" },
    { "type": "text", "id": "select_placeholder", "label": "Dropdown placeholder", "default": "Select a showroom" },
    { "type": "text", "id": "label_designer", "label": "Design consultant", "default": "Preferred design consultant, if you have one" },
    { "type": "text", "id": "label_rooms", "label": "Space question", "default": "Which space are you designing?" },
    { "type": "text", "id": "label_stages", "label": "Project stage question", "default": "Where are you in your project?" },
    { "type": "text", "id": "label_date", "label": "Date", "default": "Target project completion date" },
    { "type": "text", "id": "label_message", "label": "Message", "default": "Anything else we should know?" },

    { "type": "header", "content": "Options" },
    { "type": "paragraph", "content": "One option per line. Empty a box to hide that question entirely." },
    { "type": "textarea", "id": "showroom_options", "label": "Showrooms", "default": "Chestnut Hill" },
    { "type": "textarea", "id": "room_options", "label": "Spaces", "default": "Living Room\nDining Room\nBedroom\nOutdoor\nWhole Home\nOther" },
    { "type": "textarea", "id": "stage_options", "label": "Project stages", "default": "My space is a blank slate\nMy space needs redesigned\nMy space needs decor and accessories" },

    { "type": "header", "content": "Optional fields" },
    { "type": "checkbox", "id": "show_designer", "label": "Show design consultant field", "default": true },
    { "type": "checkbox", "id": "show_date", "label": "Show completion date field", "default": true },
    { "type": "checkbox", "id": "show_message", "label": "Show message box", "default": true },

    { "type": "header", "content": "Button and confirmation" },
    { "type": "text", "id": "submit_label", "label": "Button label", "default": "Request Appointment" },
    { "type": "textarea", "id": "footnote", "label": "Small print under button", "default": "We will be in touch within one business day." },
    { "type": "text", "id": "success_heading", "label": "Thank-you heading", "default": "Thank You" },
    { "type": "textarea", "id": "success_text", "label": "Thank-you text", "default": "Your request has been received. A Hedi's design consultant will contact you shortly." }
  ],
  "presets": [
    { "name": "Hedi's — Appointment" }
  ]
}
{% endschema %}
